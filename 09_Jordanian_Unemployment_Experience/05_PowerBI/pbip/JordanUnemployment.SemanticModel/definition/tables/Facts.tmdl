	partition Facts = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(DataFolder & "Facts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Promoted, {{"Key", type text}, {"Value", type number}, {"Label", type text}, {"Basis", type text}, {"Source", type text}}, "en-US")
				in
				  Typed

	annotation PBI_ResultType = Table
