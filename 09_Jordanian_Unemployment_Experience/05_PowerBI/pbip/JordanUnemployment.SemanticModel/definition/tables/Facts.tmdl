table Facts
	lineageTag: 1e801a90-7e14-55d6-84c1-fa71e47a6812

	column Key
		dataType: string
		lineageTag: 937f9f4e-cbff-5ca1-9560-cb6861bfdb71
		summarizeBy: none
		sourceColumn: Key

	column Value
		dataType: double
		formatString: 0.0
		lineageTag: a61eb570-daaf-55cb-934f-59b25af8a45f
		summarizeBy: none
		sourceColumn: Value

	column Label
		dataType: string
		lineageTag: ed5b79de-95c5-586a-b563-96b6954f14db
		summarizeBy: none
		sourceColumn: Label

	column Basis
		dataType: string
		lineageTag: fe3c3367-7e54-5293-ae6d-25e5d9a3e75f
