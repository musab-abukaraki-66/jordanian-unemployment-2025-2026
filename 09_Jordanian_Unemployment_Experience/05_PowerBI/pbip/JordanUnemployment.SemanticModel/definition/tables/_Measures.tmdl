table _Measures
	lineageTag: 565311be-6cfd-5488-adce-b632ef4f508b

	measure SelQ =
			SELECTEDVALUE(Quarter[Order], 18)
		displayFolder: 1 Number
		lineageTag: d3cfe9fb-c3c1-565e-8d67-ef65234b2eaa

	measure 'SelQ Label' =
			LOOKUPVALUE(Quarter[Label], Quarter[Order], [SelQ])
		displayFolder: 1 Number
		lineageTag: 6381aa7f-0940-5410-9cfc-3354c5864572

	measure 'Hero SVG' =
			VAR o = [SelQ]
			VAR lab = [SelQ Label]
			VAR v = LOOKUPVALUE(Quarter[Total], Quarter[Order], o)
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='700' height='130' viewBox='0 0 700 130'>" & "<text x='0' y='72' font-family='Georgia' font-size='64' font-weight='700' fill='rgb(181,71,46)' text-anchor='start'>" & (FORMAT(v, "0.0") & "&%2337;") & "</text>" & "<text x='240' y='48' font-family='Segoe UI Semibold' font-size='15.8' font-weight='600' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>of Jordanian citizens in the labour force</text>" & "<text x='240' y='70' font-family='Segoe UI' font-size='15.8' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & ("were unemployed in " & lab & " (age 15+).") & "</text>" & "<rect x='0' y='98' width='128' height='20' fill='rgb(28,27,25)'/><text x='11' y='112' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(241,236,226)' letter-spacing='0.4'>DoS PUBLISHED</text>" & "<rect x='136' y='98' width='208' height='20' fill='rgb(216,200,168)'/><text x='147' y='112' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(28,27,25)' letter-spacing='0.4'>JORDANIAN CITIZENS ONLY</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 1 Number
		lineageTag: bbf02673-49eb-59a5-8d78-a41965f137b1

	measure 'Chart SVG' =
			VAR o = [SelQ]
			VAR plateau = FILTER(ALL(Quarter), Quarter[Order] >= 9)
			VAR mn = MINX(plateau, Quarter[Total])
			VAR mx = MAXX(plateau, Quarter[Total])
			VAR n = COUNTROWS(plateau)
			VAR lastT = LOOKUPVALUE(Quarter[Total], Quarter[Order], 18)
			VAR lastM = LOOKUPVALUE(Quarter[Male], Quarter[Order], 18)
			VAR lastF = LOOKUPVALUE(Quarter[Female], Quarter[Order], 18)
			VAR yb = (314 - (mx - 15) * 290 / 21) - 38
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='900' height='344' viewBox='0 0 900 344'>" & "<line x1='22' y1='314.0' x2='740' y2='314.0' stroke='rgb(207,198,179)' stroke-width='0.8'/><text x='17' y='318.0' font-family='Segoe UI' font-size='13.0' text-anchor='end' fill='rgb(64,55,47)'>15</text><line x1='22' y1='245.0' x2='740' y2='245.0' stroke='rgb(207,198,179)' stroke-width='0.8'/><text x='17' y='249.0' font-family='Segoe UI' font-size='13.0' text-anchor='end' fill='rgb(64,55,47)'>20</text><line x1='22' y1='175.9' x2='740' y2='175.9' stroke='rgb(207,198,179)' stroke-width='0.8'/><text x='17' y='179.9' font-family='Segoe UI' font-size='13.0' text-anchor='end' fill='rgb(64,55,47)'>25</text><line x1='22' y1='106.9' x2='740' y2='106.9' stroke='rgb(207,198,179)' stroke-width='0.8'/><text x='17' y='110.9' font-family='Segoe UI' font-size='13.0' text-anchor='end' fill='rgb(64,55,47)'>30</text><line x1='22' y1='37.8' x2='740' y2='37.8' stroke='rgb(207,198,179)' stroke-width='0.8'/><text x='17' y='41.8' font-family='Segoe UI' font-size='13.0' text-anchor='end' fill='rgb(64,55,47)'>35</text><text x='22.0' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q1 2022</text><text x='148.7' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q4 2022</text><text x='275.4' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q3 2023</text><text x='402.1' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q2 2024</text><text x='528.8' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q1 2025</text><text x='655.5' y='340' font-family='Segoe UI' font-size='12.4' text-anchor='middle' fill='rgb(64,55,47)'>Q4 2025</text>" & "<rect x='" & ROUND((22 + (9 - 1) * 718 / 17), 1) & "' y='" & ROUND((314 - (mx - 15) * 290 / 21), 1) & "' width='" & ROUND((22 + (18 - 1) * 718 / 17) - (22 + (9 - 1) * 718 / 17), 1) & "' height='" & ROUND((314 - (mn - 15) * 290 / 21) - (314 - (mx - 15) * 290 / 21), 1) & "' fill='rgb(216,200,168)'/>" & "<line x1='" & ROUND((22 + (o - 1) * 718 / 17), 1) & "' y1='24' x2='" & ROUND((22 + (o - 1) * 718 / 17), 1) & "' y2='314' stroke='rgb(207,198,179)' stroke-width='1.5' stroke-dasharray='3 3'/>" & "<path d='" & CONCATENATEX(ALL(Quarter), IF(Quarter[Order] = 1, "M", "L") & ROUND((22 + (Quarter[Order] - 1) * 718 / 17), 1) & "," & ROUND((314 - (Quarter[Female] - 15) * 290 / 21), 1), " ", Quarter[Order]) & "' fill='none' stroke='rgb(181,71,46)' stroke-width='1.6' stroke-linejoin='round'/>" & "<path d='" & CONCATENATEX(ALL(Quarter), IF(Quarter[Order] = 1, "M", "L") & ROUND((22 + (Quarter[Order] - 1) * 718 / 17), 1) & "," & ROUND((314 - (Quarter[Male] - 15) * 290 / 21), 1), " ", Quarter[Order]) & "' fill='none' stroke='rgb(62,76,82)' stroke-width='1.6' stroke-linejoin='round'/>" & "<path d='" & CONCATENATEX(ALL(Quarter), IF(Quarter[Order] = 1, "M", "L") & ROUND((22 + (Quarter[Order] - 1) * 718 / 17), 1) & "," & ROUND((314 - (Quarter[Total] - 15) * 290 / 21), 1), " ", Quarter[Order]) & "' fill='none' stroke='rgb(28,27,25)' stroke-width='3.6' stroke-linejoin='round'/>" & CONCATENATEX(FILTER(ALL(Quarter), Quarter[FemaleBasis] = "chart label"), "<circle cx='" & ROUND((22 + (Quarter[Order] - 1) * 718 / 17), 1) & "' cy='" & ROUND((314 - (Quarter[Female] - 15) * 290 / 21), 1) & "' r='4' fill='rgb(241,236,226)' stroke='rgb(181,71,46)' stroke-width='1.6'/>", "", Quarter[Order]) & CONCATENATEX(FILTER(ALL(Quarter), Quarter[MaleBasis] = "chart label"), "<circle cx='" & ROUND((22 + (Quarter[Order] - 1) * 718 / 17), 1) & "' cy='" & ROUND((314 - (Quarter[Male] - 15) * 290 / 21), 1) & "' r='4' fill='rgb(241,236,226)' stroke='rgb(62,76,82)' stroke-width='1.6'/>", "", Quarter[Order]) & "<circle cx='" & ROUND((22 + (o - 1) * 718 / 17), 1) & "' cy='" & ROUND((314 - (LOOKUPVALUE(Quarter[Female], Quarter[Order], o) - 15) * 290 / 21), 1) & "' r='5' fill='rgb(181,71,46)'/>" & "<circle cx='" & ROUND((22 + (o - 1) * 718 / 17), 1) & "' cy='" & ROUND((314 - (LOOKUPVALUE(Quarter[Male], Quarter[Order], o) - 15) * 290 / 21), 1) & "' r='5' fill='rgb(62,76,82)'/>" & "<circle cx='" & ROUND((22 + (o - 1) * 718 / 17), 1) & "' cy='" & ROUND((314 - (LOOKUPVALUE(Quarter[Total], Quarter[Order], o) - 15) * 290 / 21), 1) & "' r='6.5' fill='rgb(28,27,25)'/>" & "<line x1='" & ROUND((22 + (9 - 1) * 718 / 17), 1) & "' y1='" & ROUND(yb, 1) & "' x2='" & ROUND((22 + (18 - 1) * 718 / 17), 1) & "' y2='" & ROUND(yb, 1) & "' stroke='rgb(28,27,25)'/><line x1='" & ROUND((22 + (9 - 1) * 718 / 17), 1) & "' y1='" & ROUND(yb - 5, 1) & "' x2='" & ROUND((22 + (9 - 1) * 718 / 17), 1) & "' y2='" & ROUND(yb + 5, 1) & "' stroke='rgb(28,27,25)'/><line x1='" & ROUND((22 + (18 - 1) * 718 / 17), 1) & "' y1='" & ROUND(yb - 5, 1) & "' x2='" & ROUND((22 + (18 - 1) * 718 / 17), 1) & "' y2='" & ROUND(yb + 5, 1) & "' stroke='rgb(28,27,25)'/>" & "<text x='" & ROUND(((22 + (9 - 1) * 718 / 17) + (22 + (18 - 1) * 718 / 17)) / 2, 1) & "' y='" & ROUND(yb - 10, 1) & "' font-family='Segoe UI Semibold' font-size='13.6' font-weight='700' text-anchor='middle' fill='rgb(28,27,25)'>" & n & " quarters between " & FORMAT(mn, "0.0") & "&%2337; and " & FORMAT(mx, "0.0") & "&%2337;</text>" & "<text x='752' y='" & ROUND((314 - (lastF - 15) * 290 / 21) + 4, 1) & "' font-family='Segoe UI Semibold' font-size='13.6' font-weight='700' fill='rgb(181,71,46)'>Women " & FORMAT(lastF, "0.0") & "</text><text x='752' y='" & ROUND((314 - (lastT - 15) * 290 / 21) + 4, 1) & "' font-family='Segoe UI Semibold' font-size='13.6' font-weight='700' fill='rgb(28,27,25)'>All Jordanians " & FORMAT(lastT, "0.0") & "</text><text x='752' y='" & ROUND((314 - (lastM - 15) * 290 / 21) + 4, 1) & "' font-family='Segoe UI Semibold' font-size='13.6' font-weight='700' fill='rgb(62,76,82)'>Men " & FORMAT(lastM, "0.0") & "</text>" & "<text x='" & ROUND((22 + (o - 1) * 718 / 17) + (IF(o > 14, -8, 8)), 1) & "' y='16' font-family='Segoe UI Semibold' font-size='13.6' font-weight='700' text-anchor='" & IF(o > 14, "end", "start") & "' fill='rgb(28,27,25)'>" & [SelQ Label] & "  ·  " & FORMAT(LOOKUPVALUE(Quarter[Total], Quarter[Order], o), "0.0") & "&%2337;  ·  men " & FORMAT(LOOKUPVALUE(Quarter[Male], Quarter[Order], o), "0.0") & "  ·  women " & FORMAT(LOOKUPVALUE(Quarter[Female], Quarter[Order], o), "0.0") & "</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 1 Number
		lineageTag: 4971a7fb-5762-52ad-98a9-1fc7f748a5c9

	measure 'Ruler SVG' =
			"data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='432' height='470' viewBox='0 0 432 470'>" & "<text x='40' y='60' font-family='Georgia' font-size='18' font-weight='700' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>All residents</text>" & "<text x='40' y='80' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>Jordanians and non-Jordanians together</text>" & "<line x1='40' y1='108' x2='400' y2='108' stroke='rgb(207,198,179)' stroke-width='1.2'/><line x1='40' y1='108' x2='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "AllRes") / 35, 1) & "' y2='108' stroke='rgb(28,27,25)' stroke-width='3'/><circle cx='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "AllRes") / 35, 1) & "' cy='108' r='7' fill='rgb(28,27,25)'/>" & "<text x='400' y='74' font-family='Georgia' font-size='24' font-weight='700' fill='rgb(28,27,25)' text-anchor='end'>" & (FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "AllRes"), "0.0") & "&%2337;") & "</text>" & "<rect x='24' y='138' width='400' height='104' fill='rgb(216,200,168)' opacity='0.6'/>" & "<text x='40' y='172' font-family='Georgia' font-size='18' font-weight='700' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>Jordanians</text>" & "<text x='40' y='192' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>citizens, age 15+</text>" & "<line x1='40' y1='220' x2='400' y2='220' stroke='rgb(207,198,179)' stroke-width='1.2'/><line x1='40' y1='220' x2='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "Jord") / 35, 1) & "' y2='220' stroke='rgb(181,71,46)' stroke-width='3'/><circle cx='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "Jord") / 35, 1) & "' cy='220' r='7' fill='rgb(181,71,46)'/>" & "<text x='400' y='186' font-family='Georgia' font-size='24' font-weight='700' fill='rgb(181,71,46)' text-anchor='end'>" & (FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "Jord"), "0.0") & "&%2337;") & "</text>" & "<text x='40' y='284' font-family='Georgia' font-size='18' font-weight='700' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>Jordanian women</text>" & "<text x='40' y='304' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>citizens, age 15+</text>" & "<line x1='40' y1='332' x2='400' y2='332' stroke='rgb(207,198,179)' stroke-width='1.2'/><line x1='40' y1='332' x2='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "JordWomen") / 35, 1) & "' y2='332' stroke='rgb(28,27,25)' stroke-width='3'/><circle cx='" & ROUND(40 + 360 * LOOKUPVALUE(Facts[Value], Facts[Key], "JordWomen") / 35, 1) & "' cy='332' r='7' fill='rgb(28,27,25)'/>" & "<text x='400' y='298' font-family='Georgia' font-size='24' font-weight='700' fill='rgb(28,27,25)' text-anchor='end'>" & (FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "JordWomen"), "0.0") & "&%2337;") & "</text>" & "<text x='40' y='372' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & ("Non-Jordanian residents: " & FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "NonJord"), "0.0") & "&%2337;.") & "</text>" & "<text x='40' y='392' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & ("Expatriate workers are " & FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "ExpatShare"), "0") & "&%2337; of the employed") & "</text>" & "<text x='40' y='412' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & ("(Q2 2026), so the all-resident rate is lower.") & "</text>" & "<rect x='40' y='432' width='224' height='20' fill='rgb(28,27,25)'/><text x='51' y='446' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(241,236,226)' letter-spacing='0.4'>DoS PUBLISHED  ·  Q2 2026</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 1 Number
		lineageTag: 8265aa97-ca19-5523-aef1-c25f9ba2468e

	measure 'People SVG' =
			VAR dE = LOOKUPVALUE(Annual[Employed], Annual[Year], 2025) - LOOKUPVALUE(Annual[Employed], Annual[Year], 2020)
			VAR dU = LOOKUPVALUE(Annual[Unemployed], Annual[Year], 2025) - LOOKUPVALUE(Annual[Unemployed], Annual[Year], 2020)
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='432' height='150' viewBox='0 0 432 150'>" & "<text x='40' y='44' font-family='Georgia' font-size='34' font-weight='700' fill='rgb(28,27,25)' text-anchor='start'>" & ("+" & FORMAT(dE, "#,0")) & "</text>" & "<text x='230' y='44' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>more Jordanians employed</text>" & "<text x='40' y='88' font-family='Georgia' font-size='34' font-weight='700' fill='rgb(181,71,46)' text-anchor='start'>" & ("+" & FORMAT(dU, "#,0")) & "</text>" & "<text x='230' y='88' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>more Jordanians unemployed</text>" & "<text x='40' y='118' font-family='Segoe UI' font-size='14.1' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & ("Rate over the same years: " & FORMAT(LOOKUPVALUE(Annual[RateDerived], Annual[Year], 2020), "0.0") & "&%2337; to " & FORMAT(LOOKUPVALUE(Annual[RateDerived], Annual[Year], 2025), "0.0") & "&%2337;.") & "</text>" & "<rect x='40' y='132' width='208' height='20' fill='rgb(181,71,46)'/><text x='51' y='146' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(241,236,226)' letter-spacing='0.4'>DERIVED FROM DoS COUNTS</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 1 Number
		lineageTag: 55b15e32-efaa-5ed0-98e3-9f2251046c2a

	measure SelLens =
			SELECTEDVALUE(Lens[Lens], "Sex")
		displayFolder: 2 People
		lineageTag: 4314946f-6512-509f-86d2-3a69aae7c238

	measure 'Dots SVG' =
			VAR lens = [SelLens]
			VAR dots = CONCATENATEX(FILTER(ALL(Dots), Dots[Lens] = lens), "<circle cx='" & (Dots[Col] * 29 + 11) & "' cy='" & (Dots[Row] * 29 + 11) & "' r='11' fill='" & Dots[Rgb] & "'/>", "", Dots[Idx])
			VAR labels = CONCATENATEX(FILTER(ALL(LegendKey), LegendKey[Lens] = lens), "<text x='318' y='" & (LegendKey[MidY] + 14) & "' font-family='Georgia' font-weight='700' font-size='40.0' fill='" & LegendKey[TextRgb] & "'>" & LegendKey[Count] & "</text><text x='398' y='" & (LegendKey[MidY] + 12) & "' font-family='Segoe UI Semibold' font-size='16.9' fill='rgb(28,27,25)'>" & LegendKey[Label] & "</text>", "", LegendKey[GroupOrder])
			VAR cap = SELECTEDVALUE(Lens[Caption], "")
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='360' viewBox='0 0 640 360'>" & dots & labels & "<text x='0' y='334' font-family='Segoe UI' font-size='14.1' fill='rgb(64,55,47)'>Of every 100 unemployed Jordanians. " & cap & "</text></svg>"
		dataCategory: ImageUrl
		displayFolder: 2 People
		lineageTag: e5375563-bd0a-598c-a291-289567de7758

	measure 'Rate SVG' =
			"data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='620' height='320' viewBox='0 0 620 320'>" & CONCATENATEX(GENERATESERIES(1, 100), "<circle cx='" & (0 + MOD([Value] - 1, 10) * 24 + 9) & "' cy='" & (INT(([Value] - 1) / 10) * 24 + 9) & "' r='9' fill='" & IF([Value] <= ROUND(LOOKUPVALUE(Facts[Value], Facts[Key], "MenRate"), 0), "rgb(62,76,82)", "rgb(230,223,208)") & "'/>", "", [Value]) & "<text x='0' y='292' font-family='Georgia' font-size='48' font-weight='700' fill='rgb(62,76,82)' text-anchor='start'>" & (ROUND(LOOKUPVALUE(Facts[Value], Facts[Key], "MenRate"), 0)) & "</text>" & "<text x='62' y='262' font-family='Segoe UI Semibold' font-size='15.8' font-weight='600' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>of 100 men</text>" & "<text x='62' y='281' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>in the labour force</text>" & "<text x='62' y='300' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(28,27,25)' text-anchor='start'>" & ("unemployed: " & FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "MenRate"), "0.00") & "&%2337;") & "</text>" & CONCATENATEX(GENERATESERIES(1, 100), "<circle cx='" & (290 + MOD([Value] - 1, 10) * 24 + 9) & "' cy='" & (INT(([Value] - 1) / 10) * 24 + 9) & "' r='9' fill='" & IF([Value] <= ROUND(LOOKUPVALUE(Facts[Value], Facts[Key], "WomenRate"), 0), "rgb(181,71,46)", "rgb(230,223,208)") & "'/>", "", [Value]) & "<text x='290' y='292' font-family='Georgia' font-size='48' font-weight='700' fill='rgb(181,71,46)' text-anchor='start'>" & (ROUND(LOOKUPVALUE(Facts[Value], Facts[Key], "WomenRate"), 0)) & "</text>" & "<text x='352' y='262' font-family='Segoe UI Semibold' font-size='15.8' font-weight='600' fill='rgb(28,27,25)' text-anchor='start' letter-spacing='0'>of 100 women</text>" & "<text x='352' y='281' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>in the labour force</text>" & "<text x='352' y='300' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(28,27,25)' text-anchor='start'>" & ("unemployed: " & FORMAT(LOOKUPVALUE(Facts[Value], Facts[Key], "WomenRate"), "0.00") & "&%2337;") & "</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 2 People
		lineageTag: 3f02c0e9-92eb-510b-bef3-dd553bafdeea

	measure SelGov =
			SELECTEDVALUE(DimGov[Name], "")
		displayFolder: 3 Places
		lineageTag: 14f4a783-67d6-5269-903c-c01810667da7

	measure 'Map SVG' =
			VAR sel = [SelGov]
			VAR paths = CONCATENATEX(ALL(DimGov), "<path d='" & DimGov[PathD] & "' fill='" & DimGov[Fill] & "' stroke='rgb(241,236,226)' stroke-width='1.4' opacity='" & IF(sel = "" || sel = DimGov[Name], "1", "0.4") & "'/>", "", DimGov[Order])
			VAR topPath = CONCATENATEX(FILTER(ALL(DimGov), DimGov[Name] = sel), "<path d='" & DimGov[PathD] & "' fill='none' stroke='rgb(28,27,25)' stroke-width='3'/>", "", DimGov[Order])
			VAR discs = CONCATENATEX(ALL(DimGov), "<circle cx='" & DimGov[CX] & "' cy='" & DimGov[CY] & "' r='" & (DimGov[R] + 2) & "' fill='rgb(241,236,226)' opacity='0.9'/><circle cx='" & DimGov[CX] & "' cy='" & DimGov[CY] & "' r='" & DimGov[R] & "' fill='" & IF(sel = DimGov[Name], "rgb(181,71,46)", "rgb(28,27,25)") & "' opacity='0.9'/>", "", DimGov[Order])
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='700' height='500' viewBox='0 0 700 500'>" & paths & topPath & discs & "<rect x='480' y='398' width='12' height='10' fill='rgb(216,200,168)'/><rect x='492' y='398' width='12' height='10' fill='rgb(214,191,159)'/><rect x='504' y='398' width='12' height='10' fill='rgb(211,182,151)'/><rect x='516' y='398' width='12' height='10' fill='rgb(208,172,142)'/><rect x='528' y='398' width='12' height='10' fill='rgb(206,163,133)'/><rect x='540' y='398' width='12' height='10' fill='rgb(204,154,124)'/><rect x='552' y='398' width='12' height='10' fill='rgb(201,145,116)'/><rect x='564' y='398' width='12' height='10' fill='rgb(198,136,107)'/><rect x='576' y='398' width='12' height='10' fill='rgb(196,126,98)'/><rect x='588' y='398' width='12' height='10' fill='rgb(194,117,90)'/><rect x='600' y='398' width='12' height='10' fill='rgb(191,108,81)'/><rect x='612' y='398' width='12' height='10' fill='rgb(171,66,43)'/><rect x='624' y='398' width='12' height='10' fill='rgb(151,56,36)'/><rect x='636' y='398' width='12' height='10' fill='rgb(130,46,30)'/><rect x='648' y='398' width='12' height='10' fill='rgb(110,36,23)'/><text x='480' y='428' font-family='Segoe UI' font-size='12.4' fill='rgb(64,55,47)'>15%</text><text x='660' y='428' font-family='Segoe UI' font-size='12.4' text-anchor='end' fill='rgb(64,55,47)'>29%</text><text x='480' y='388' font-family='Segoe UI Semibold' font-size='12.4' font-weight='700' letter-spacing='1' fill='rgb(64,55,47)'>RATE</text><circle cx='490' cy='462' r='3.5' fill='rgb(28,27,25)'/><circle cx='516' cy='462' r='7.1' fill='rgb(28,27,25)'/><text x='532' y='466' font-family='Segoe UI' font-size='12.4' fill='rgb(64,55,47)'>5k / 20k people</text></svg>"
		dataCategory: ImageUrl
		displayFolder: 3 Places
		lineageTag: 7b6e9356-9c94-5212-9a38-a42d334bc569

	measure 'Ledger SVG' =
			VAR sel = [SelGov]
			VAR rws = CONCATENATEX(ALL(DimGov), IF(sel = DimGov[Name], "<rect x='0' y='" & (DimGov[RowY] - 21) & "' width='560' height='30' fill='rgb(216,200,168)' opacity='0.75'/>", "")
			  & "<circle cx='14' cy='" & DimGov[RowY] & "' r='8' fill='none' stroke='rgb(28,27,25)' stroke-width='1.2'/>"
			  & "<rect x='38' y='" & (DimGov[RowY] - 6) & "' width='12' height='12' fill='" & DimGov[Fill] & "'/>"
			  & "<text x='60' y='" & (DimGov[RowY] + 5) & "' font-family='Segoe UI' font-size='15.8' font-weight='" & IF(sel = DimGov[Name], "700", "400") & "' fill='rgb(28,27,25)'>" & DimGov[Name] & "</text>"
			  & "<text x='262' y='" & (DimGov[RowY] + 6) & "' font-family='Georgia' font-weight='700' font-size='18.1' text-anchor='end' fill='" & IF(DimGov[Rate] >= 24, "rgb(181,71,46)", "rgb(28,27,25)") & "'>" & FORMAT(DimGov[Rate], "0.0") & "&%2337;</text>"
			  & "<text x='396' y='" & (DimGov[RowY] + 5) & "' font-family='Segoe UI' font-size='14.7' text-anchor='end' fill='rgb(28,27,25)'>" & FORMAT(DimGov[Unemployed], "#,0") & "</text>"
			  & "<rect x='412' y='" & (DimGov[RowY] - 4) & "' width='" & MAX(2, ROUND(DimGov[Unemployed] / 155900 * 100, 1)) & "' height='9' fill='rgb(28,27,25)'/>"
			  & "<text x='556' y='" & (DimGov[RowY] + 5) & "' font-family='Segoe UI' font-size='14.7' text-anchor='end' fill='rgb(64,55,47)'>" & FORMAT(DimGov[Share] * 100, "0") & "&%2337;</text>", "", DimGov[Order])
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='560' height='412' viewBox='0 0 560 412'>" & rws & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 3 Places
		lineageTag: d19cbb4b-9326-5584-9dc6-cb1a1a32e637

	measure 'Panel SVG' =
			VAR sel = [SelGov]
			VAR r = SELECTEDVALUE(DimGov[Rate], BLANK())
			VAR u = SELECTEDVALUE(DimGov[Unemployed], BLANK())
			VAR sh = SELECTEDVALUE(DimGov[Share], BLANK())
			VAR note = SELECTEDVALUE(DimGov[Note1], "")
			VAR note2 = SELECTEDVALUE(DimGov[Note2], "")
			VAR hdg = IF(sel = "", "NATIONWIDE  ·  JORDANIANS 15+", "SELECTED  ·  " & UPPER(sel))
			VAR big = IF(sel = "", FORMAT(LOOKUPVALUE(Annual[RateDerived], Annual[Year], 2025), "0.0"), FORMAT(r, "0.0")) & "&%2337;"
			VAR l1 = IF(sel = "", "derived 2025 annual rate", IF(r > LOOKUPVALUE(Annual[RateDerived], Annual[Year], 2025), "above the national derived rate of ", "below the national derived rate of ") & FORMAT(LOOKUPVALUE(Annual[RateDerived], Annual[Year], 2025), "0.0") & "&%2337;")
			VAR l2 = IF(sel = "", FORMAT(LOOKUPVALUE(Annual[Unemployed], Annual[Year], 2025), "#,0") & " unemployed Jordanians", FORMAT(u, "#,0") & " unemployed Jordanians (" & FORMAT(sh * 100, "0") & "&%2337; of all)")
			VAR l3 = IF(sel = "", "Select a governorate on the map or in the ledger. Select it again to clear.", note)
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='560' height='200' viewBox='0 0 560 200'>" & "<rect x='1' y='1' width='558' height='160' fill='none' stroke='rgb(28,27,25)' stroke-width='1'/>" & "<rect x='0' y='174' width='208' height='20' fill='rgb(181,71,46)'/><text x='11' y='188' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(241,236,226)' letter-spacing='0.4'>DERIVED FROM DoS COUNTS</text>" & "<rect x='216' y='174' width='312' height='20' fill='rgb(216,200,168)'/><text x='227' y='188' font-family='Segoe UI Semibold' font-size='12.4' fill='rgb(28,27,25)' letter-spacing='0.4'>NOT A DoS-PUBLISHED GOVERNORATE RATE</text>" & "<text x='16' y='30' font-family='Segoe UI Semibold' font-size='13.0' font-weight='700' fill='rgb(181,71,46)' text-anchor='start'>" & (hdg) & "</text>" & "<text x='16' y='80' font-family='Georgia' font-size='40' font-weight='700' fill='rgb(181,71,46)' text-anchor='start'>" & (big) & "</text>" & "<text x='160' y='64' font-family='Segoe UI Semibold' font-size='14.7' font-weight='600' fill='rgb(28,27,25)' text-anchor='start'>" & (l1) & "</text>" & "<text x='160' y='86' font-family='Segoe UI' font-size='14.7' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & (l2) & "</text>" & "<text x='16' y='110' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & (l3) & "</text>" & "<text x='16' y='130' font-family='Segoe UI' font-size='13.6' font-weight='400' fill='rgb(64,55,47)' text-anchor='start'>" & (note2) & "</text>" & "<text x='16' y='150' font-family='Segoe UI' font-size='13.0' font-weight='400' fill='rgb(64,55,47)' text-anchor='start' letter-spacing='0'>DoS publishes no sampling error; small governorates can swing year to year.</text>" & "</svg>"
		dataCategory: ImageUrl
		displayFolder: 3 Places
		lineageTag: 15e9ca55-44b1-5f3a-b37b-4dc97b38a7a9

	column Placeholder
		lineageTag: 6895ed67-d471-51a5-b74a-9fcb87fc4fb9
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", 1)
